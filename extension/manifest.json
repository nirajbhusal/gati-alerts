{
  "manifest_version": 3,
  "name": "गति Gati: Nepal alerts",
  "short_name": "Gati",
  "version": "1.0.0",
  "description": "Official disaster and weather alerts for Nepal, relayed with source and time. सही सूचना, सही समयमा ।",
  "homepage_url": "https://nirajbhusal.github.io/gati-alerts/",
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "action": {
    "default_title": "Gati: Nepal alerts",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" }
  },
  "background": { "service_worker": "background.js" },
  "permissions": ["alarms", "storage", "notifications"],
  "host_permissions": ["https://nirajbhusal.github.io/gati-alerts/*"]
}
